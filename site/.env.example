# Copy to .env for local testing and set the same names in the Vercel project.
# The reCAPTCHA v2 secret is the one the WordPress site used (recovered from the
# backup); the SMTP password is the Gmail app password for the send-as account.
RECAPTCHA_SECRET_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@theburgerboxes.com
SMTP_PASS=
MAIL_FROM_EMAIL=info@theburgerboxes.com
MAIL_FROM_NAME="The Burger Boxes"
FORM_TO=
ORDER_TO=info@theburgerboxes.com
# Set only while testing; remove before the final production deploy.
# FORM_TO_OVERRIDE=
