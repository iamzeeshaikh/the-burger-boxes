---
// The theme's page wrapper, matching the markup WordPress emitted for the cart
// page: breadcrumb, article, entry header, entry content.
import { ORIGIN } from '../lib/site.js';

const { postId, title, crumb, route } = Astro.props;
const SITE = ORIGIN;
---
<div class="site-content">
	<div class="rishi-container" data-strech="none">
		<div class=" main-content-wrapper clear rishi-spacing-both">
			<main id="primary" class="site-main">
				<div class="rishi-container-wrap">
					<div id="crumbs" class="rishi-breadcrumb-main-wrap">
						<div class="rishi-breadcrumbs align-left">
							<span><a href={SITE}><span>Home</span></a><meta content="1" /><span class="separator"><svg width="12" height="20" viewBox="0 0 12 20" fill="none" xmlns="http://www.w3.org/2000/svg">
								<g clip-path="url(#clip0_510_103040)">
									<path d="M1.82516 0.234375L10.9918 9.40104L11.5643 10.0002L10.9918 10.5994L1.82516 19.766L0.62683 18.5677L9.19516 10.0002L0.625998 1.43271L1.82516 0.234375Z" fill="currentColor"/>
								</g>
								<defs>
									<clipPath id="clip0_510_103040">
										<rect width="11.6667" height="20" fill="white" transform="matrix(-1 0 0 1 11.851 0)"/>
									</clipPath>
								</defs>
							</svg></span></span><span class="current"><a href={SITE + route}><span>{crumb}</span></a><meta content="2" /></span>
						</div>
					</div><!-- .crumbs -->
					<article id={`post-${postId}`} class={`post-${postId} page type-page status-publish hentry rishi-post no-post-thumbnail`}>
						<header class="entry-header">
							<h1 class="entry-title">{title}</h1>
						</header><!-- .entry-header -->
						<div class="entry-content">
							<slot />
						</div><!-- .entry-content -->
					</article><!-- #post-## -->
				</div><!-- .rishi-container-wrap -->
			</main><!-- #main -->
		</div><!-- .main-content-wrapper -->
	</div><!-- .rishi-container-->
</div><!-- .site-content -->
