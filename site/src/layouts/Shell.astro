---
// The site chrome, driven by a captured page record. `[...path].astro` renders
// the migrated pages with it; the cart-flow pages WordPress never served as
// static HTML (checkout, order received) borrow the cart page's record so they
// inherit the same head, body classes, header, footer and scripts.
//
// The literal whitespace between regions is the theme's own; it is emitted from
// constants rather than from the template so the built markup stays
// byte-identical to what WordPress served.
import { rewrite } from '../lib/site.js';
import { applySeo } from '../lib/seo.js';
import { RECAPTCHA_SRC } from '../lib/protect.js';
import { applySchemaPrice } from '../lib/price.js';
import { CART_JS_URL, CATALOGUE_URL } from '../lib/assets.js';
import { schemaFor, stripPasteResidue } from '../lib/schema.js';
import { skipLink } from '../lib/chrome.js';
import Header from '../components/Header.astro';
import Offcanvas from '../components/Offcanvas.astro';
import Footer from '../components/Footer.astro';
import JoinChat from '../components/JoinChat.astro';

const { page, needsRecaptcha = false, schema = [] } = Astro.props;

// Elementor only enqueued reCAPTCHA's script on pages whose forms it had
// configured with one; the forms we guard after the fact need it too.
// Breadcrumbs and the FAQ tab, described for machines -- see src/lib/schema.js.
// A route may add blocks of its own; articles describe themselves that way.
const extraSchema = [
  schemaFor(page),
  ...schema.map((b) => '<script type="application/ld+json">' +
    JSON.stringify(b).replace(/<\/script/gi, '<\\/script') + '</script>'),
].filter(Boolean).join('\n');

const head = rewrite(applySchemaPrice(applySeo(page.head, page.route))) +
  (extraSchema ? '\n' + extraSchema + '\n' : '') +
  (needsRecaptcha && !page.head.includes('recaptcha/api.js')
    ? `\n<script src="${RECAPTCHA_SRC}" async defer></script>\n`
    : '');
const OPEN_MAIN = '<div id="main-container" class="site">\n\t\t\t';
const SEP_HEADER = '\n\t\t\t\t';
const SEP_OFFCANVAS = '\n\t\t\n\t\t';
const SEP_CONTENT = '\n\t\t\t\t\t\t';
const SEP_FOOTER = '\n\t\t\t\t\t\t';
const CLOSE_MAIN = '\n\t\t\t\t</div><!-- #page -->';
// The WhatsApp widget sits between the late stylesheets and the vendor scripts
// WordPress prints after the page wrapper, so bodyTail is split around it.
const [tailBefore, tailAfter = ''] = stripPasteResidue(rewrite(page.bodyTail)).split('<!--JOINCHAT-->');
---
<!DOCTYPE html>
<html lang="en-US"><head><Fragment set:html={head} /></head>

<body class={page.bodyClass}><Fragment set:html={rewrite(page.bodyOpen) + OPEN_MAIN + skipLink + SEP_HEADER} /><Header page={page} /><Fragment set:html={SEP_OFFCANVAS} /><Offcanvas page={page} /><Fragment set:html={SEP_CONTENT} /><slot /><Fragment set:html={SEP_FOOTER} /><Footer page={page} /><Fragment set:html={CLOSE_MAIN + tailBefore} /><JoinChat page={page} /><Fragment set:html={tailAfter} /><script is:inline define:vars={{ url: CATALOGUE_URL }}>window.__TBB_CATALOGUE = url;</script><script is:inline src={CART_JS_URL} defer></script></body>
</html>

<style is:global>
  /* "Starting from" pricing -- see src/lib/price.js */
  .tbb-from-label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: #6b7280;
    line-height: 1.3;
  }
  .tbb-price-line {
    margin: 4px 0 18px;
    padding: 14px 16px;
    background: #fffaf0;
    border: 1px solid #f5dfa8;
    border-radius: 8px;
  }
  .tbb-price-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: #6b7280;
  }
  .tbb-price-amount {
    font-size: 28px;
    font-weight: 700;
    color: #17191a;
    line-height: 1.1;
  }
  .tbb-price-unit { font-size: 15px; color: #4c5358; }
  .tbb-price-note {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: #4c5358;
  }
</style>
