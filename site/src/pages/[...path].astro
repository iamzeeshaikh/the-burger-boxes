---
import pages from '../data/pages.json';
import { rewrite } from '../lib/site.js';
import Shell from '../layouts/Shell.astro';
import QuoteSection from '../components/QuoteSection.astro';
import { protectForms } from '../lib/protect.js';
import { applyPricing } from '../lib/price.js';

// `_404` is served by src/pages/404.astro and `_search` by the /?s= endpoint,
// so neither is built as a normal route.
export function getStaticPaths() {
  const NOT_ROUTES = new Set(['_404', '_search']);
  return Object.values(pages)
    .filter((page) => !NOT_ROUTES.has(page.slug))
    .map((page) => ({
      // Astro's rest param wants the path without leading/trailing slash;
      // trailingSlash: 'always' + build.format 'directory' restore them.
      params: { path: page.route === '/' ? undefined : page.route.slice(1, -1) },
      props: { page },
    }));
}

const { page } = Astro.props;
// The seven product-category archives shipped without any form; everything
// else on the site already carries one.
const showQuote = page.route.startsWith('/product-category/') &&
  page.route !== '/product-category/uncategorized/';

// The unguarded "Contact Us" copies on /about-us/ and the policy pages get the
// same honeypot + reCAPTCHA every other form on the site already has.
const { html: guarded, needsScript } = protectForms(rewrite(page.content));
// Every displayed price is a from-price, and each product page states its own.
const content = applyPricing(guarded, page.route);
---
<Shell page={page} needsRecaptcha={needsScript || showQuote}>
  <Fragment set:html={content} />
  {showQuote && <QuoteSection page={page} />}
</Shell>
