      "destination": "https://theburgerboxes.com/sitemap.xml",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/wp-admin/admin-ajax.php",
      "destination": "/api/admin-ajax"
    },
    {
      "source": "/wp-comments-post.php",
      "destination": "/api/comments-post"
    },
    {
      "source": "/wp-json/joinchat/v1/track-click",
      "destination": "/api/joinchat-track"
    },
    {
      "source": "/comments/feed/",
      "destination": "/comments-feed.xml"
    },
    {
      "source": "/feed/",
      "destination": "/feed.xml"
    },
    {
      "source": "/product-category/Boxes-By-Customization/",
      "destination": "/product-category/boxes-by-customization/"
    },
    {
      "source": "/product-category/Boxes-By-Material/",
      "destination": "/product-category/boxes-by-material/"
    },
    {
      "source": "/product-category/Boxes-By-Type/",
      "destination": "/product-category/boxes-by-type/"
    },
    {
      "source": "/product-category/boxes-by-Color/",
      "destination": "/product-category/boxes-by-color/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/feed/",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=UTF-8"
        }
      ]
    },
    {
      "source": "/comments/feed/",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=UTF-8"
        }
      ]
    },
    {
      "source": "/cart/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/checkout/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/checkout/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/my-account/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/my-account/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/thank-you/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/author/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/category/uncategorized/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/product-category/uncategorized/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/assets/cart.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/catalogue.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
