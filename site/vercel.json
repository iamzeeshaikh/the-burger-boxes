    {
      "source": "/product/import-placeholder-for-68",
      "destination": "https://theburgerboxes.com/product/cardboard-burger-boxes/",
      "permanent": true
    },
    {
      "source": "/product/import-placeholder-for-73",
      "destination": "https://theburgerboxes.com/product/takeaway-burger-boxes/",
      "permanent": true
    },
    {
      "source": "/product/import-placeholder-for-78",
      "destination": "https://theburgerboxes.com/product/clamshell-burger-boxes/",
      "permanent": true
    },
    {
      "source": "/product/import-placeholder-for-83",
      "destination": "https://theburgerboxes.com/product/personalised-burger-boxes/",
      "permanent": true
    },
    {
      "source": "/product/import-placeholder-for-90",
      "destination": "https://theburgerboxes.com/product/branded-burger-boxes/",
      "permanent": true
    },
    {
      "source": "/product/import-placeholder-for-95",
      "destination": "https://theburgerboxes.com/product/premium-burger-boxes/",
      "permanent": true
    },
    {
      "source": "/products/page/1",
      "destination": "https://theburgerboxes.com/products/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "query",
          "key": "add-to-cart"
        }
      ],
      "destination": "/api/gone"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "s"
        }
      ],
      "destination": "/api/search"
    },
    {
      "source": "/page/:n(\\d+)",
      "has": [
        {
          "type": "query",
          "key": "s"
        }
      ],
      "destination": "/api/search"
    },
    {
      "source": "/wp-admin/admin-ajax.php",
      "destination": "/api/admin-ajax"
    },
    {
      "source": "/comments/feed",
      "destination": "/comments-feed.xml"
    },
    {
      "source": "/feed",
      "destination": "/feed.xml"
    },
    {
      "source": "/product-category/Boxes-By-Customization",
      "destination": "/product-category/boxes-by-customization/"
    },
    {
      "source": "/product-category/Boxes-By-Material",
      "destination": "/product-category/boxes-by-material/"
    },
    {
      "source": "/product-category/Boxes-By-Type",
      "destination": "/product-category/boxes-by-type/"
    },
    {
      "source": "/product-category/boxes-by-Color",
      "destination": "/product-category/boxes-by-color/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/feed/",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=UTF-8"
        }
      ]
    },
    {
      "source": "/comments/feed/",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=UTF-8"
        }
      ]
    }
  ]
}